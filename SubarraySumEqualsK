// Leetcode 560
// video link: https://youtu.be/YxRmeRyVQm4?si=oDQ_837ysDigKZoj
class Solution {
    public int subarraySum(int[] nums, int k) {
        // using the concept of a prefixSum
        Map<Integer, Integer> map= new HashMap<>();
        map.put(0,1); // the prefixsum is 0 when no arrays subarrays are selcted
        int ans =0;
        int prefixSum = 0;

        for(int num: nums){
            prefixSum += num;
            if(map.containsKey(prefixSum - k)){
                ans += map.get(prefixSum - k);
            }

            map.put(prefixSum, map.getOrDefault(prefixSum, 0) + 1);
        }
        
        return ans;
    }
}
