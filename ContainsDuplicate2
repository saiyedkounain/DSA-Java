class Solution {
    public boolean containsNearbyDuplicate(int[] nums, int k) {
        //use a sliding window (apparently)
        //same as the last one, but slight modification
        Set <Integer> set = new HashSet<>();
        int n = nums.length;
        for(int i=0;i<n;i++){
            if(set.contains(nums[i])){
                return true;
            }

            set.add(nums[i]);

            //maintainig a sliding window
            if(set.size() > k){
                //lets remove the element that came into the set first
                set.remove(nums[i - k]);
            }
        }

        return false;
       
    }
}
